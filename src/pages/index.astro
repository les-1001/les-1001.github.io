---
import { getCollection, getEntry } from "astro:content";
import type { CollectionEntry } from "astro:content";
import Base from "../layouts/Base.astro";
import LogList from "../components/LogList.astro";
import ProjectPanel from "../components/ProjectPanel.astro";
import { site } from "../site.config";
import { formatDate, statusLabel } from "../lib/format";

const byOrder = (a: { data: { order: number } }, b: { data: { order: number } }) =>
  a.data.order - b.data.order;
const projects = (await getCollection("projects")).sort(byOrder);
const groups = (await getCollection("groups")).sort(byOrder);
const log = (await getCollection("log")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const latest = log[0];
const latestProject = latest ? await getEntry(latest.data.project) : undefined;

const contact = [
  site.email && { label: "Email", href: `mailto:${site.email}` },
  site.github && { label: "GitHub", href: site.github },
  site.linkedin && { label: "LinkedIn", href: site.linkedin },
  site.cv && { label: "CV (PDF)", href: site.cv },
].filter(Boolean) as { label: string; href: string }[];

const updatesFor = (p: CollectionEntry<"projects">) =>
  log.filter((e) => e.data.project.id === p.id);

// Top-level tabs: projects without a group, plus one tab per group
// holding its projects as sub-tabs. Sorted by `order`.
type Tab =
  | { kind: "project"; key: string; order: number; project: CollectionEntry<"projects"> }
  | {
      kind: "group";
      key: string;
      order: number;
      group: CollectionEntry<"groups">;
      members: CollectionEntry<"projects">[];
    };
const tabs: Tab[] = [
  ...projects
    .filter((p) => !p.data.group)
    .map((p) => ({ kind: "project" as const, key: `project-${p.id}`, order: p.data.order, project: p })),
  ...groups
    .map((g) => ({
      kind: "group" as const,
      key: `group-${g.id}`,
      order: g.data.order,
      group: g,
      members: projects.filter((p) => p.data.group?.id === g.id),
    }))
    .filter((g) => g.members.length > 0),
].sort((a, b) => a.order - b.order);

const tabInfo = (t: Tab) =>
  t.kind === "project"
    ? { label: t.project.data.tabLabel ?? t.project.data.title, status: t.project.data.status }
    : { label: t.group.data.tabLabel ?? t.group.data.title, status: t.group.data.status };
---

<Base>
  <section class="hero">
    <h1 class="name">{site.name}</h1>
    <p class="tagline">{site.tagline}</p>
    <p class="contact">
      {contact.map((c) => <a href={c.href}>{c.label}</a>)}
    </p>
  </section>

  {
    latest && latestProject && (
      <a class="latest" href={`/log/${latest.id}/`}>
        <span class="latest-meta">
          Latest update, {formatDate(latest.data.date)}, on{" "}
          {latestProject.data.title}
        </span>
        <span class="latest-title">{latest.data.title}</span>
      </a>
    )
  }

  <h2 id="projects">Projects</h2>
  <div class="tabs" data-tabs>
    {/* Tab buttons stay hidden until the script runs. Without JavaScript
        every project is shown one after another instead. */}
    <div class="tablist" role="tablist" aria-label="Projects" hidden>
      {
        tabs.map((t, i) => (
          <button
            type="button"
            role="tab"
            class="tab"
            id={`tab-${t.key}`}
            aria-controls={t.key}
            aria-selected={i === 0 ? "true" : "false"}
            tabindex={i === 0 ? 0 : -1}
          >
            <span class={`dot dot-${tabInfo(t).status}`} aria-hidden="true" />
            {tabInfo(t).label}
          </button>
        ))
      }
    </div>

    {
      tabs.map((t) => (
        <section
          class="panel"
          id={t.key}
          role="tabpanel"
          aria-labelledby={`tab-${t.key}`}
          tabindex="0"
        >
          {t.kind === "project" ? (
            <ProjectPanel project={t.project} updates={updatesFor(t.project)} headingLevel={3} />
          ) : (
            <>
              <header class="group-head">
                <span class={`status status-${t.group.data.status}`}>
                  {statusLabel[t.group.data.status]}
                </span>
                <h3 class="group-title">{t.group.data.title}</h3>
                <p class="group-summary">{t.group.data.summary}</p>
                {t.group.data.role && <p class="muted group-role">{t.group.data.role}</p>}
              </header>

              <div class="tabs" data-tabs>
                <div
                  class="tablist sub"
                  role="tablist"
                  aria-label={`${t.group.data.title} projects`}
                  hidden
                >
                  {t.members.map((p, i) => (
                    <button
                      type="button"
                      role="tab"
                      class="subtab"
                      id={`tab-project-${p.id}`}
                      aria-controls={`project-${p.id}`}
                      aria-selected={i === 0 ? "true" : "false"}
                      tabindex={i === 0 ? 0 : -1}
                    >
                      {p.data.tabLabel ?? p.data.title}
                    </button>
                  ))}
                </div>
                {t.members.map((p) => (
                  <section
                    class="panel subpanel"
                    id={`project-${p.id}`}
                    role="tabpanel"
                    aria-labelledby={`tab-project-${p.id}`}
                    tabindex="0"
                  >
                    <ProjectPanel project={p} updates={updatesFor(p)} headingLevel={4} />
                  </section>
                ))}
              </div>
            </>
          )}
        </section>
      ))
    }
  </div>

  <h2>Recent updates</h2>
  <LogList entries={log.slice(0, 5)} />
  {log.length > 5 && <p class="all-link"><a href="/log/">All updates</a></p>}
</Base>

<script>
  // Accessible tabs, nestable: click or arrow keys to switch. The URL hash
  // remembers the open tab, and a hash pointing at a sub-tab (for example
  // #project-calibur-aim-tools) opens its group tab as well.
  for (const root of document.querySelectorAll<HTMLElement>("[data-tabs]")) {
    // Only this level's elements, not those of a tab set nested inside it.
    const own = <T extends Element>(selector: string) =>
      [...root.querySelectorAll<T>(selector)].filter(
        (el) => el.closest("[data-tabs]") === root,
      );
    const list = own<HTMLElement>('[role="tablist"]')[0];
    const tabs = own<HTMLButtonElement>('[role="tab"]');
    const panels = tabs.map((t) =>
      document.getElementById(t.getAttribute("aria-controls") ?? ""),
    );
    if (!list || tabs.length === 0 || panels.some((p) => !p)) continue;

    const select = (i: number, opts: { focus?: boolean; hash?: boolean } = {}) => {
      tabs.forEach((tab, j) => {
        const on = j === i;
        tab.setAttribute("aria-selected", String(on));
        tab.tabIndex = on ? 0 : -1;
        panels[j]!.hidden = !on;
      });
      if (opts.focus) tabs[i].focus();
      if (opts.hash) history.replaceState(null, "", `#${panels[i]!.id}`);
    };

    const fromHash = () => {
      const id = decodeURIComponent(location.hash.slice(1));
      if (!id) return -1;
      return panels.findIndex(
        (p) => p!.id === id || p!.querySelector(`#${CSS.escape(id)}`) !== null,
      );
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener("click", () => select(i, { hash: true }));
      tab.addEventListener("keydown", (e) => {
        const last = tabs.length - 1;
        const next =
          e.key === "ArrowRight" ? (i === last ? 0 : i + 1)
          : e.key === "ArrowLeft" ? (i === 0 ? last : i - 1)
          : e.key === "Home" ? 0
          : e.key === "End" ? last
          : -1;
        if (next < 0) return;
        e.preventDefault();
        select(next, { focus: true, hash: true });
      });
    });

    window.addEventListener("hashchange", () => {
      const i = fromHash();
      if (i >= 0) select(i);
    });

    list.hidden = false;
    root.classList.add("is-enhanced");
    select(Math.max(fromHash(), 0));
  }
</script>

<style>
  .hero {
    padding: 3.5rem 0 1.5rem;
  }
  .name {
    font-size: clamp(2.6rem, 9vw, 4.6rem);
    font-variation-settings: "wdth" 125;
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 0.98;
    margin: 0 0 1.1rem;
  }
  .tagline {
    font-size: 1.2rem;
    max-width: 34rem;
    margin-bottom: 1rem;
  }
  .contact {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
  }
  .latest {
    display: block;
    margin: 1.5rem 0 0;
    padding: 1rem 1.15rem;
    border-left: 3px solid var(--accent);
    background: var(--surface);
    color: var(--ink);
    text-decoration: none;
  }
  .latest:hover .latest-title {
    color: var(--accent);
  }
  .latest-meta {
    display: block;
    font-size: 0.85rem;
    color: var(--muted);
    margin-bottom: 0.2rem;
  }
  .latest-title {
    font-weight: 600;
  }

  /* Top-level tabs */
  .tablist {
    display: flex;
    gap: 0.25rem;
    overflow-x: auto;
    scrollbar-width: none;
    border-bottom: 1px solid var(--rule);
  }
  .tablist[hidden] {
    display: none;
  }
  .tablist::-webkit-scrollbar {
    display: none;
  }
  .tab {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 0.95rem;
    margin-bottom: -1px;
    border: 0;
    border-bottom: 2px solid transparent;
    background: none;
    color: var(--muted);
    font: 500 0.98rem/1.2 var(--body);
    white-space: nowrap;
    cursor: pointer;
  }
  .tab:hover {
    color: var(--ink);
  }
  .tab[aria-selected="true"] {
    color: var(--ink);
    border-bottom-color: var(--accent);
  }
  .tab:focus-visible,
  .subtab:focus-visible {
    outline-offset: -2px;
  }
  .dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--planned);
  }
  .dot-live {
    background: var(--live);
  }
  .dot-in-progress {
    background: var(--wip);
  }
  .dot-upcoming {
    background: var(--soon);
  }

  /* Group header and its sub-tabs (pill style, to read as a second level) */
  .group-head {
    padding: 1.75rem 0 0;
  }
  .group-title {
    font-size: clamp(1.5rem, 4.5vw, 2rem);
    font-variation-settings: "wdth" 112;
    font-weight: 800;
    letter-spacing: -0.015em;
    margin: 0.75rem 0 0.6rem;
  }
  .group-summary {
    font-size: 1.1rem;
    max-width: 36rem;
  }
  .group-role {
    margin-top: -0.5rem;
  }
  .tablist.sub {
    gap: 0.4rem;
    flex-wrap: wrap;
    border-bottom: 0;
    padding: 0.5rem 0 0.25rem;
  }
  .subtab {
    flex: none;
    padding: 0.4rem 0.85rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: var(--surface);
    color: var(--muted);
    font: 500 0.9rem/1.2 var(--body);
    white-space: nowrap;
    cursor: pointer;
  }
  .subtab:hover {
    color: var(--ink);
    border-color: var(--muted);
  }
  .subtab[aria-selected="true"] {
    color: var(--accent);
    border-color: var(--accent);
  }

  /* Without JS the panels stack, each separated by a rule. */
  .panel {
    border-top: 1px solid var(--rule);
  }
  .is-enhanced > .panel {
    border-top: 0;
  }
  .panel:focus-visible {
    outline-offset: 6px;
  }
  .all-link {
    margin-top: 1rem;
  }
</style>
