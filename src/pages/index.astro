---
import { getCollection, getEntry } from "astro:content";
import Base from "../layouts/Base.astro";
import LogList from "../components/LogList.astro";
import ProjectDetail from "../components/ProjectDetail.astro";
import { site } from "../site.config";
import { formatDate } from "../lib/format";

const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
);
const log = (await getCollection("log")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const latest = log[0];
const latestProject = latest ? await getEntry(latest.data.project) : undefined;

const contact = [
  site.email && { label: "Email", href: `mailto:${site.email}` },
  site.github && { label: "GitHub", href: site.github },
  site.linkedin && { label: "LinkedIn", href: site.linkedin },
  site.cv && { label: "CV (PDF)", href: site.cv },
].filter(Boolean) as { label: string; href: string }[];

// One tab per project, each with that project's updates (newest first).
const tabs = projects.map((p) => ({
  project: p,
  updates: log.filter((e) => e.data.project.id === p.id),
}));
---

<Base>
  <section class="hero">
    <h1 class="name">{site.name}</h1>
    <p class="tagline">{site.tagline}</p>
    <p class="contact">
      {contact.map((c) => <a href={c.href}>{c.label}</a>)}
    </p>
  </section>

  {
    latest && latestProject && (
      <a class="latest" href={`/log/${latest.id}/`}>
        <span class="latest-meta">
          Latest update, {formatDate(latest.data.date)}, on{" "}
          {latestProject.data.title}
        </span>
        <span class="latest-title">{latest.data.title}</span>
      </a>
    )
  }

  <h2 id="projects">Projects</h2>
  <div class="tabs" data-tabs>
    {/* Hidden until the script runs. Without JavaScript every project
        is shown one after another instead. */}
    <div class="tablist" role="tablist" aria-label="Projects" hidden>
      {
        tabs.map(({ project: p }, i) => (
          <button
            type="button"
            role="tab"
            class="tab"
            id={`tab-${p.id}`}
            aria-controls={`project-${p.id}`}
            aria-selected={i === 0 ? "true" : "false"}
            tabindex={i === 0 ? 0 : -1}
          >
            <span class={`dot dot-${p.data.status}`} aria-hidden="true" />
            {p.data.tabLabel ?? p.data.title}
          </button>
        ))
      }
    </div>

    {
      tabs.map(({ project: p, updates }) => (
        <section
          class="panel"
          id={`project-${p.id}`}
          role="tabpanel"
          aria-labelledby={`tab-${p.id}`}
          tabindex="0"
        >
          <ProjectDetail project={p} headingLevel={3} />

          <div class="panel-updates">
            <h4>Recent updates</h4>
            <LogList entries={updates.slice(0, 3)} showProject={false} />
          </div>
          <p class="panel-footer">
            <a href={`/projects/${p.id}/`}>
              Full project page
              {updates.length > 0 &&
                ` with all ${updates.length} ${updates.length === 1 ? "update" : "updates"}`}
            </a>
          </p>
        </section>
      ))
    }
  </div>

  <h2>Recent updates</h2>
  <LogList entries={log.slice(0, 5)} />
  {log.length > 5 && <p class="all-link"><a href="/log/">All updates</a></p>}
</Base>

<script>
  // Accessible tabs: click or arrow keys to switch, and the URL hash
  // (#project-<id>) remembers the open tab so it can be linked to.
  for (const root of document.querySelectorAll<HTMLElement>("[data-tabs]")) {
    const list = root.querySelector<HTMLElement>('[role="tablist"]');
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = tabs.map((t) =>
      document.getElementById(t.getAttribute("aria-controls") ?? ""),
    );
    if (!list || tabs.length === 0 || panels.some((p) => !p)) continue;

    const select = (i: number, opts: { focus?: boolean; hash?: boolean } = {}) => {
      tabs.forEach((tab, j) => {
        const on = j === i;
        tab.setAttribute("aria-selected", String(on));
        tab.tabIndex = on ? 0 : -1;
        panels[j]!.hidden = !on;
      });
      if (opts.focus) tabs[i].focus();
      if (opts.hash) history.replaceState(null, "", `#${panels[i]!.id}`);
    };

    const fromHash = () => panels.findIndex((p) => `#${p!.id}` === location.hash);

    tabs.forEach((tab, i) => {
      tab.addEventListener("click", () => select(i, { hash: true }));
      tab.addEventListener("keydown", (e) => {
        const last = tabs.length - 1;
        const next =
          e.key === "ArrowRight" ? (i === last ? 0 : i + 1)
          : e.key === "ArrowLeft" ? (i === 0 ? last : i - 1)
          : e.key === "Home" ? 0
          : e.key === "End" ? last
          : -1;
        if (next < 0) return;
        e.preventDefault();
        select(next, { focus: true, hash: true });
      });
    });

    window.addEventListener("hashchange", () => {
      const i = fromHash();
      if (i >= 0) select(i);
    });

    list.hidden = false;
    root.classList.add("is-enhanced");
    select(Math.max(fromHash(), 0));
  }
</script>

<style>
  .hero {
    padding: 3.5rem 0 1.5rem;
  }
  .name {
    font-size: clamp(2.6rem, 9vw, 4.6rem);
    font-variation-settings: "wdth" 125;
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 0.98;
    margin: 0 0 1.1rem;
  }
  .tagline {
    font-size: 1.2rem;
    max-width: 34rem;
    margin-bottom: 1rem;
  }
  .contact {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
  }
  .latest {
    display: block;
    margin: 1.5rem 0 0;
    padding: 1rem 1.15rem;
    border-left: 3px solid var(--accent);
    background: var(--surface);
    color: var(--ink);
    text-decoration: none;
  }
  .latest:hover .latest-title {
    color: var(--accent);
  }
  .latest-meta {
    display: block;
    font-size: 0.85rem;
    color: var(--muted);
    margin-bottom: 0.2rem;
  }
  .latest-title {
    font-weight: 600;
  }

  /* Tabs */
  .tablist {
    display: flex;
    gap: 0.25rem;
    overflow-x: auto;
    scrollbar-width: none;
    border-bottom: 1px solid var(--rule);
  }
  .tablist[hidden] {
    display: none;
  }
  .tablist::-webkit-scrollbar {
    display: none;
  }
  .tab {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 0.95rem;
    margin-bottom: -1px;
    border: 0;
    border-bottom: 2px solid transparent;
    background: none;
    color: var(--muted);
    font: 500 0.98rem/1.2 var(--body);
    white-space: nowrap;
    cursor: pointer;
  }
  .tab:hover {
    color: var(--ink);
  }
  .tab[aria-selected="true"] {
    color: var(--ink);
    border-bottom-color: var(--accent);
  }
  .tab:focus-visible {
    outline-offset: -2px;
  }
  .dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--planned);
  }
  .dot-live {
    background: var(--live);
  }
  .dot-in-progress {
    background: var(--wip);
  }
  .dot-upcoming {
    background: var(--soon);
  }

  /* Without JS the panels stack, each separated by a rule. */
  .panel {
    border-top: 1px solid var(--rule);
  }
  .is-enhanced .panel {
    border-top: 0;
  }
  .panel:focus-visible {
    outline-offset: 6px;
  }
  .panel-updates {
    margin-top: 2rem;
  }
  .panel-updates h4 {
    font-family: var(--display);
    font-size: 1rem;
    font-weight: 650;
    margin: 0 0 0.75rem;
  }
  .panel-footer {
    margin: 1.25rem 0 0;
    padding-bottom: 1.5rem;
    font-weight: 500;
  }
  .all-link {
    margin-top: 1rem;
  }
</style>
