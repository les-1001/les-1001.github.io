---
import { getCollection, getEntry, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { formatDate } from "../../lib/format";

export async function getStaticPaths() {
  const log = await getCollection("log");
  return log.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const project = await getEntry(entry.data.project);
const { Content } = await render(entry);
---

<Base title={entry.data.title}>
  <article class="entry">
    <p class="meta">
      <time datetime={entry.data.date.toISOString().slice(0, 10)}>
        {formatDate(entry.data.date)}
      </time>
      {
        project && (
          <>
            {" "}
            in <a href={`/projects/${project.id}/`}>{project.data.title}</a>
          </>
        )
      }
    </p>
    <h1>{entry.data.title}</h1>
    <div class="prose">
      <Content />
    </div>
    <p class="back"><a href="/log/">All updates</a></p>
  </article>
</Base>

<style>
  .entry {
    padding-top: 2.5rem;
  }
  .meta {
    color: var(--muted);
    font-size: 0.92rem;
    margin-bottom: 0.4rem;
  }
  .entry h1 {
    margin-bottom: 1.5rem;
  }
  .back {
    margin-top: 2.5rem;
  }
</style>
