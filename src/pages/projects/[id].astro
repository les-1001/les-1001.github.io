---
import { getCollection, getEntry } from "astro:content";
import Base from "../../layouts/Base.astro";
import LogList from "../../components/LogList.astro";
import ProjectDetail from "../../components/ProjectDetail.astro";
import { formatPeriod } from "../../lib/format";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const group = project.data.group ? await getEntry(project.data.group) : undefined;
const updates = (await getCollection("log"))
  .filter((e) => e.data.project.id === project.id)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Base title={project.data.title} description={project.data.summary}>
  <article class="project">
    <ProjectDetail
      project={project}
      partOf={group && {
        title: group.data.title,
        href: `/#group-${group.id}`,
        period: formatPeriod(group.data.start, group.data.end),
      }}
    />

    <h2>Updates</h2>
    <LogList entries={updates} showProject={false} />
  </article>
</Base>
