---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import LogList from "../../components/LogList.astro";
import ProjectDetail from "../../components/ProjectDetail.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const updates = (await getCollection("log"))
  .filter((e) => e.data.project.id === project.id)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Base title={project.data.title} description={project.data.summary}>
  <article class="project">
    <ProjectDetail project={project} />

    <h2>Updates</h2>
    <LogList entries={updates} showProject={false} />
  </article>
</Base>
