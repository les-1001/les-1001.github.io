---
import "@fontsource-variable/archivo/wdth.css";
import "@fontsource/ibm-plex-sans/400.css";
import "@fontsource/ibm-plex-sans/400-italic.css";
import "@fontsource/ibm-plex-sans/500.css";
import "@fontsource/ibm-plex-sans/600.css";
import { site } from "../site.config";

interface Props {
  title?: string;
  description?: string;
}
const { title, description = site.tagline } = Astro.props;
const pageTitle = title ? `${title} | ${site.name}` : site.name;
const path = Astro.url.pathname;
const nav = [
  { href: "/", label: "Home" },
  { href: "/log/", label: "Log" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <header class="site-header">
      <a class="wordmark" href="/">{site.name}</a>
      <nav aria-label="Main">
        {
          nav.map((item) => (
            <a
              href={item.href}
              aria-current={
                item.href === "/"
                  ? path === "/"
                    ? "page"
                    : undefined
                  : path.startsWith(item.href)
                    ? "page"
                    : undefined
              }
            >
              {item.label}
            </a>
          ))
        }
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <span>{site.name}, {new Date().getFullYear()}</span>
      <span class="footer-links">
        {site.email && <a href={`mailto:${site.email}`}>Email</a>}
        {site.github && <a href={site.github}>GitHub</a>}
        {site.linkedin && <a href={site.linkedin}>LinkedIn</a>}
      </span>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --paper: #f4f6f8;
    --surface: #ffffff;
    --ink: #121c26;
    --muted: #5b6b79;
    --rule: #d9e0e6;
    --accent: #2747c9;
    --live: #1e7a4c;
    --live-bg: #e3f2ea;
    --wip: #94600a;
    --wip-bg: #fbefd9;
    --planned: #5b6b79;
    --planned-bg: #e7ecf0;
    --soon: #2747c9;
    --soon-bg: #e4e9fb;
    --display: "Archivo Variable","Helvetica Neue", Arial, sans-serif;
    --body: "IBM Plex Sans", system-ui, sans-serif;
    --measure: 44rem;
    color-scheme: light dark;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --paper: #0f161d;
      --surface: #16202a;
      --ink: #e4ebf1;
      --muted: #93a3b1;
      --rule: #263441;
      --accent: #8fa3ff;
      --live: #6fd3a0;
      --live-bg: #12301f;
      --wip: #f0bf6a;
      --wip-bg: #33260f;
      --planned: #93a3b1;
      --planned-bg: #1e2a35;
      --soon: #8fa3ff;
      --soon-bg: #1c2545;
    }
  }
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
  html {
    background: var(--paper);
    color: var(--ink);
    font-family: var(--body);
    font-size: 17px;
    line-height: 1.6;
    -webkit-text-size-adjust: 100%;
  }
  body {
    margin: 0 auto;
    max-width: calc(var(--measure) + 2.5rem);
    padding: 0 1.25rem;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }
  main {
    flex: 1;
    padding-bottom: 4rem;
  }
  a {
    color: var(--accent);
    text-underline-offset: 0.18em;
    text-decoration-thickness: 1px;
  }
  a:hover {
    text-decoration-thickness: 2px;
  }
  :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: 2px;
  }
  h1,
  h2,
  h3 {
    font-family: var(--display);
    font-variation-settings: "wdth" 100;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }
  h1 {
    font-size: 2.2rem;
    font-weight: 750;
    margin: 0 0 0.5rem;
  }
  h2 {
    font-size: 1.35rem;
    font-weight: 700;
    margin: 2.75rem 0 1rem;
  }
  h3 {
    font-size: 1.1rem;
    font-weight: 650;
    margin: 2rem 0 0.5rem;
  }
  p,
  ul,
  ol {
    margin: 0 0 1rem;
  }
  img {
    max-width: 100%;
    height: auto;
    border-radius: 6px;
  }
  code {
    font-size: 0.88em;
    background: var(--planned-bg);
    padding: 0.1em 0.35em;
    border-radius: 4px;
  }
  pre {
    overflow-x: auto;
    padding: 1rem;
    border-radius: 6px;
    font-size: 0.85rem;
  }
  table {
    border-collapse: collapse;
    width: 100%;
    font-size: 0.92rem;
    margin-bottom: 1rem;
    display: block;
    overflow-x: auto;
  }
  th,
  td {
    text-align: left;
    padding: 0.4rem 0.75rem 0.4rem 0;
    border-bottom: 1px solid var(--rule);
  }
  .muted {
    color: var(--muted);
  }

  .site-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding: 1.5rem 0 1rem;
  }
  .wordmark {
    font-family: var(--display);
    font-weight: 700;
    color: var(--ink);
    text-decoration: none;
  }
  .site-header nav {
    display: flex;
    gap: 1.25rem;
  }
  .site-header nav a {
    color: var(--muted);
    text-decoration: none;
  }
  .site-header nav a[aria-current="page"],
  .site-header nav a:hover {
    color: var(--ink);
  }
  .site-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    padding: 1.5rem 0 2rem;
    border-top: 1px solid var(--rule);
    color: var(--muted);
    font-size: 0.88rem;
  }
  .footer-links {
    display: flex;
    gap: 1rem;
  }
  .footer-links a {
    color: var(--muted);
  }

  .status {
    display: inline-block;
    font-size: 0.78rem;
    font-weight: 500;
    line-height: 1;
    padding: 0.32rem 0.55rem;
    border-radius: 999px;
    white-space: nowrap;
  }
  .status-live {
    color: var(--live);
    background: var(--live-bg);
  }
  .status-in-progress {
    color: var(--wip);
    background: var(--wip-bg);
  }
  .status-upcoming {
    color: var(--soon);
    background: var(--soon-bg);
  }
  .status-planned {
    color: var(--planned);
    background: var(--planned-bg);
  }

  .button-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 1.25rem 0 0;
  }
  .button {
    display: inline-block;
    padding: 0.5rem 0.95rem;
    border-radius: 6px;
    border: 1px solid var(--rule);
    background: var(--surface);
    color: var(--ink);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.92rem;
  }
  .button:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .button.primary {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--paper);
  }
  .button.primary:hover {
    color: var(--paper);
    filter: brightness(1.08);
  }

  .prose {
    max-width: var(--measure);
  }
  .prose figure {
    margin: 0 0 1.75rem;
  }
  .prose figure img {
    display: block;
    border: 1px solid var(--rule);
  }
  .prose figcaption {
    margin-top: 0.5rem;
    font-size: 0.88rem;
    color: var(--muted);
  }
  .prose h2:first-child {
    margin-top: 0;
  }
</style>
