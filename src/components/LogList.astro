---
import type { CollectionEntry } from "astro:content";
import { getEntry } from "astro:content";
import { formatDate } from "../lib/format";

interface Props {
  entries: CollectionEntry<"log">[];
  showProject?: boolean;
}
const { entries, showProject = true } = Astro.props;
const rows = await Promise.all(
  entries.map(async (e) => ({
    entry: e,
    project: showProject ? await getEntry(e.data.project) : undefined,
  })),
);
---

{
  rows.length === 0 ? (
    <p class="muted">No updates yet. The first one will show up here.</p>
  ) : (
    <ol class="timeline">
      {rows.map(({ entry, project }) => (
        <li>
          <time datetime={entry.data.date.toISOString().slice(0, 10)}>
            {formatDate(entry.data.date)}
          </time>
          <div>
            <a class="entry-title" href={`/log/${entry.id}/`}>
              {entry.data.title}
            </a>
            {project && (
              <span class="entry-project">
                <a href={`/projects/${project.id}/`}>{project.data.title}</a>
              </span>
            )}
          </div>
        </li>
      ))}
    </ol>
  )
}

<style>
  .timeline {
    list-style: none;
    padding: 0;
    margin: 0;
    border-left: 2px solid var(--rule);
  }
  .timeline li {
    position: relative;
    display: grid;
    grid-template-columns: 7.2rem 1fr;
    gap: 0.25rem 1rem;
    padding: 0.55rem 0 0.55rem 1.1rem;
  }
  .timeline li::before {
    content: "";
    position: absolute;
    left: -6px;
    top: 1.05rem;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--paper);
    border: 2px solid var(--accent);
  }
  time {
    color: var(--muted);
    font-size: 0.9rem;
    font-variant-numeric: tabular-nums;
    padding-top: 0.08rem;
  }
  .entry-title {
    color: var(--ink);
    font-weight: 500;
    text-decoration: none;
  }
  .entry-title:hover {
    color: var(--accent);
    text-decoration: underline;
  }
  .entry-project {
    display: block;
    font-size: 0.85rem;
  }
  .entry-project a {
    color: var(--muted);
  }
  @media (max-width: 520px) {
    .timeline li {
      grid-template-columns: 1fr;
    }
  }
</style>
